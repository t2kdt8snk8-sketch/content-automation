# ─── LLM Proxy ───────────────────────────────────────────────────────────────
# Local: points to free-claude-code proxy (run it first: cd free-claude-code && uv run python server.py)
# Railway: set to the deployed proxy service URL
LLM_BASE_URL=http://localhost:8082

# Proxy accepts any non-empty value; set a real key if using Anthropic API directly
ANTHROPIC_API_KEY=dummy-proxied

# ─── Model IDs (proxy maps these to NIM/backend models) ───────────────────────
MODEL_OPUS="nvidia_nim/moonshotai/kimi-k2.5"
MODEL_SONNET="nvidia_nim/qwen/qwen3.5-397b-a17b"
MODEL_HAIKU="nvidia_nim/z-ai/glm4.7"

# ─── Research Sources ────────────────────────────────────────────────────────
NEWS_API_KEY=9c7344ef80574108807d48070d7b4e6c
YOUTUBE_DATA_API_KEY=AIzaSyCbnmAimhmAesqZ16wXcHuRIF5Sh01SwZA
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Your Telegram user ID — only this user can send requests to the bot.
# Get yours by messaging @userinfobot on Telegram.
# Leave empty to allow all users (not recommended for production).
TELEGRAM_BOT_TOKEN="8719245781:AAGOBaljFZSFRvK0PdyktXzm6lmQ68JszQw"
ALLOWED_TELEGRAM_USER_ID="5619781276"

# ─── Web UI ───────────────────────────────────────────────────────────────────
# 브라우저 접속 시 입력할 비밀번호
WEB_PASSWORD=ilbmabp2051*
# Railway가 자동으로 PORT를 주입함 — 로컬에서는 8000이 기본값
# PORT=8000

# ─── Storage ──────────────────────────────────────────────────────────────────
OUTPUTS_DIR=outputs
SCAN_CATEGORIES=black music culture,fashion,jazz
SCAN_INTERVAL_HOURS=5
# 5분처럼 더 짧게 돌리고 싶으면 분 단위 설정을 우선 사용
# SCAN_INTERVAL_MINUTES=5

# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
